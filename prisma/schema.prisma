generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  VIEWER
}

enum SubmissionType {
  CONTACT
  PICKUP
  DONATION
  PARTNERSHIP
  SELL
}

enum SubmissionStatus {
  NEW
  IN_PROGRESS
  SCHEDULED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum DeviceStatus {
  RECEIVED
  DIAGNOSING
  REPAIRING
  REFURBISHED
  DONATED
  RECYCLED
  SOLD
  DISPOSED
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         Role         @default(SUPER_ADMIN)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  submissions  Submission[] @relation("SubmissionAssignee")
}

model Submission {
  id           String           @id @default(cuid())
  publicToken  String           @unique @default(cuid())
  type         SubmissionType
  name         String
  email        String?
  phone        String?
  location     String?
  message      String?
  details      Json?
  status       SubmissionStatus @default(NEW)
  assignedToId String?
  assignedTo   User?            @relation("SubmissionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  scheduledAt  DateTime?
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  devices      Device[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model DevicePrice {
  id          String   @id @default(cuid())
  deviceType  String
  brand       String?
  modelName   String?
  age         String?
  condition   String?
  price       Int
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([deviceType])
  @@index([active])
}

model Device {
  id            String       @id @default(cuid())
  submissionId  String?
  submission    Submission?  @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  deviceType    String
  brand         String?
  model         String?
  age           String?
  condition     String?
  accessories   Json?
  description   String?
  offerAmount   Int?
  pricingSource String?
  matchedPrice  String?
  reference     String?
  photoNames    Json?
  receiptName   String?
  status        DeviceStatus @default(RECEIVED)
  outcomeNote   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([submissionId])
  @@index([reference])
  @@index([createdAt])
}
